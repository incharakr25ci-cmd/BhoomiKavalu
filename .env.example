# Bhoomi Kavalu - Backend Environment Configuration
# Copy this file to .env and replace placeholder values before production deployment.

# SQLite / SQLAlchemy Database URL
DATABASE_URL=sqlite:///./bhoomi_kavalu.db

# JWT Authentication Secret (replace with a strong random string)
SECRET_KEY=change-this-to-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# SMS / GSM Alert Module
SMS_PROVIDER=gsm
GSM_PORT=COM3
GSM_BAUD_RATE=9600
DEMO_MODE=true

# Firebase Realtime Database URL (do not commit private service-account JSON keys)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
